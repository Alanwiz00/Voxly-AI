# App
APP_ENV=development
# Generate with: openssl rand -base64 32
SECRET_KEY=your-secret-key-min-32-chars-change-this

# Comma-separated admin emails — seeded into allowed_emails on first boot
# Admins can create API keys (vlx-...) for agent-to-agent integrations
ADMIN_EMAILS=you@gmail.com

# PostgreSQL (Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.yourproject.supabase.co:5432/postgres

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# OpenAI — vision (image ingest), embeddings, and last-resort text generation
# (used only when both Groq and Gemini fail; model: OPENAI_TEXT_MODEL, gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-api-key

# Text generation — REQUIRED for /generate and /generate/from-source to work.
# Order: Groq → Gemini → OpenAI. At least one of these three must be set or
# every generation call fails with "No LLM providers configured".
GROQ_API_KEY=gsk_your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Auth (must match NEXTAUTH_SECRET in frontend)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# CORS — comma-separated allowed frontend origins
# Production: https://app.yourdomain.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# MCP Server — API key for the VoxlyAI MCP service (Settings > API Keys)
VOXLY_MCP_API_KEY=vlx-your-mcp-server-key

# Fetch.ai uAgent — separate API key and a stable identity seed
# Generate seed with: python -c "import secrets; print(secrets.token_hex(32))"
VOXLY_FETCH_API_KEY=vlx-your-fetch-agent-key
FETCH_AGENT_SEED=your-64-char-hex-seed-change-this
# Public HTTPS URL Agentverse uses to deliver messages to this agent
# Set up a domain on Dokploy pointing to fetch-agent:8002, then set it here
FETCH_AGENT_ENDPOINT=https://agent.yourdomain.com/submit
# Agentverse API key — shown on the "Launch your agent" page, copy from there
AGENTVERSE_KEY=your-agentverse-key-here

# ── Listening & outreach on X (admin-only Listening page) ─────────────────────
# Read-only X API v2 access, pay-per-use. Replies are always sent by a person from
# X's own reply box, never through the API.
X_BEARER_TOKEN=your-x-app-bearer-token
# Numeric user ID of the X account that sends the replies. Its mentions are read
# to track replies and "stop" requests. Blank = reply tracking off.
X_ACCOUNT_USER_ID=
# Hard monthly stop on X spend across all campaigns, in USD. Each campaign also
# has its own budget on the Listening page.
LISTENING_MONTHLY_BUDGET_USD=15
# Optional overrides (defaults shown). Keep prices in sync with the X developer console.
# X_API_BASE_URL=https://api.x.com
# X_PRICE_POST_READ=0.005
# X_PRICE_USER_READ=0.010
# X_PRICE_COUNTS_REQUEST=0.005
# X_QUERY_MAX_CHARS=512   # 4096 on enterprise access

# BetEye: winning-alert proof for drafts, and signed signup/payment events back.
BETEYE_API_URL=https://api.beteye.live
# Must equal OUTREACH_API_KEY in BetEye. Generate with: openssl rand -hex 32
BETEYE_OUTREACH_KEY=
# Must equal OUTREACH_WEBHOOK_SECRET in BetEye. Generate with: openssl rand -hex 32
LISTENING_WEBHOOK_SECRET=

